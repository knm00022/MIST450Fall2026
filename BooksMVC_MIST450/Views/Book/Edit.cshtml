@model Book 

<div class="container card p-5 shadow-lg mx-auto">

    <h1>Edit Book Record</h1>

    <form asp-action="Edit">

        <input type="hidden" asp-for="BookId" />

        <div class="row mb-3">
            
            <label asp-for="Title" class="col-md-2 col-form-label"></label>

            <div class="col-md-10">
                 <input asp-for="Title" class="form-control" />
            </div>


        </div> 

        <div class="row mb-3">
            
            <label asp-for="Description" class="col-md-2 col-form-label"></label>

            <div class="col-md-10">
                 <input asp-for="Description" class="form-control" />
            </div>


        </div>

        <div class="row mb-3">
            
            <label asp-for="Author" class="col-md-2 col-form-label"></label>

            <div class="col-md-10">
                 <input asp-for="Author" class="form-control" />
            </div>


        </div>

        <div class="row mb-3">
            
            <label asp-for="DatePublished" class="col-md-2 col-form-label"></label>

            <div class="col-md-10">
                 <input asp-for="DatePublished" class="form-control" />
            </div>


        </div>

        <div class="row mb-3">
            
            <label asp-for="Genre" class="col-md-2 col-form-label"></label>

            <div class="col-md-10">
                 <input asp-for="Genre" class="form-control" />
            </div>


        </div>

                <div class="row mb-3">

            <label asp-for="Price" class="col-md-2 col-form-label"></label>

            <div class="col-md-10">
                <input asp-for="Price" class="form-control" />
            </div>

        </div> 

        <div class="mb-3">
            <button type="submit" class="btn btn-outline-success w-100">Update Book Information</button>
        </div>

    </form>

</div>